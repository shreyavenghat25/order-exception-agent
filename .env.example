# Default: fully offline mock models. Uncomment one block to use a real LLM.

# --- Claude (Anthropic)
# EXOPS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# EXOPS_SMALL_MODEL=<small/fast Claude model id>
# EXOPS_LARGE_MODEL=<larger Claude model id>

# --- OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# EXOPS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EXOPS_SMALL_MODEL=<small model id>
# EXOPS_LARGE_MODEL=<large model id>

# --- Local Ollama
# EXOPS_PROVIDER=ollama
# EXOPS_SMALL_MODEL=qwen2.5:7b
# EXOPS_LARGE_MODEL=qwen2.5:32b

# Router / budgets / policy
# EXOPS_ESCALATE_BELOW=0.75
# EXOPS_MAX_COST_INR=2.0
# EXOPS_AUTO_REFUND_LIMIT=5000
